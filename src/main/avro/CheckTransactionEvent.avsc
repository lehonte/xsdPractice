{
    "type": "record",
    "name": "CheckTransactionEvent",
    "namespace": "org.example.events",
    "fields": [
        {
            "name": "email",
            "type": "string"
        },
        {
            "name": "transactionNumber",
            "type": "string"
        },
        {
            "name": "amount",
            "type": {
                "type": "bytes",
                "logicalType": "decimal",
                "precision": 16,
                "scale": 2
            }
        },
        {
            "name": "owner",
            "type": "string"
        }
    ]
}